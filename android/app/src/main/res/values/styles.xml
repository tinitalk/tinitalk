<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#08111F</item>
        <item name="android:statusBarColor">#08111F</item>
        <item name="android:colorAccent">#D4AF37</item>
    </style>

    <style name="CallTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#07111F</item>
        <item name="android:statusBarColor">#14213D</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
